# Bot page > Reset Token in the Discord Developer Portal.
DISCORD_TOKEN=

# General Information > Application ID (not the public key or client secret).
DISCORD_APPLICATION_ID=

# * enables every installed server. Or enter comma-separated server IDs to restrict access.
DISCORD_GUILD_IDS=*

# Optional legacy server ID. Command sync clears its old guild-scoped commands.
# If DISCORD_GUILD_IDS is unset, a nonempty legacy ID restricts the bot to that server.
DISCORD_GUILD_ID=

# Optional AI chat. Leave AI_API_KEY empty to run only the basic commands.
# Use a key and model name from the same provider. There is no hardcoded model.
AI_API_KEY=
AI_MODEL=

# OpenAI-compatible API base URL (do not append /chat/completions).
AI_BASE_URL=https://api.openai.com/v1

# Use max_tokens if your provider does not support max_completion_tokens.
AI_TOKEN_LIMIT_PARAM=max_completion_tokens
AI_MAX_OUTPUT_TOKENS=2048

# Optional model-specific reasoning setting. Blank uses the provider default.
# For DeepSeek browsing with portable text history, use none.
AI_REASONING_EFFORT=

# Local HSR lore search tool. False keeps automatic lore context for models without tool calling.
AI_LORE_TOOLS=true

# Optional web search and page reading, using DeepSeek Search & Fetch.
# Use a DeepSeek key here even if AI_API_KEY belongs to another chat provider.
# Leaving WEB_API_KEY empty disables web tools. Web requests use the web provider's billing.
WEB_API_KEY=
WEB_BASE_URL=https://api.deepseek.com/v1/tools

# Optional: use another persona file. Blank uses personas/fourth-mirror.md.
AI_PERSONA_FILE=

# Optional: replace the persona with inline instructions (takes precedence over the file).
AI_SYSTEM_PROMPT=

# Portable conversation transcripts. Keep this path on persistent storage.
AI_HISTORY_FILE=data/chats.json

# Image input is enabled by default. Set false for models without vision.
AI_VISION_ENABLED=true
