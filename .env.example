# Bot page > Reset Token in the Discord Developer Portal.
DISCORD_TOKEN=

# General Information > Application ID (not the public key or client secret).
DISCORD_APPLICATION_ID=

# Enable Developer Mode in Discord, then right-click your server > Copy Server ID.
DISCORD_GUILD_ID=

# Optional AI chat. Leave AI_API_KEY empty to run only the basic commands.
# Use a key and model name from the same provider. There is no hardcoded model.
AI_API_KEY=
AI_MODEL=

# OpenAI-compatible API base URL (do not append /chat/completions).
AI_BASE_URL=https://api.openai.com/v1

# Use max_tokens if your provider does not support max_completion_tokens.
AI_TOKEN_LIMIT_PARAM=max_completion_tokens
AI_MAX_OUTPUT_TOKENS=2048

# Optional: override the assistant's default personality/instructions.
AI_SYSTEM_PROMPT=

# Portable conversation transcripts. Keep this path on persistent storage.
AI_HISTORY_FILE=data/chats.json
