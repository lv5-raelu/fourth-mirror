{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "fourth-mirror",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": { "DISCORD_GUILD_IDS": "*" },
  "durable_objects": { "bindings": [{ "name": "BOT", "class_name": "DiscordBot" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DiscordBot"] }],
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    }
  }
}
