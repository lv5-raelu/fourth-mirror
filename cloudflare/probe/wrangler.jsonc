{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fourth-mirror-feasibility-probe",
  "main": "worker.js",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "PROBE_LOCAL": "false" },
  "durable_objects": {
    "bindings": [{ "name": "BOT", "class_name": "BotProbe" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BotProbe"] }],
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }]
}
