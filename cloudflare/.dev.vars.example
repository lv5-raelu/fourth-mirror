# Copy to cloudflare/.dev.vars for LOCAL development only. Never commit real values.
# Production settings are uploaded with `npm run cloudflare:secrets -- PATH_TO_ENV`.
ADMIN_TOKEN=replace-with-a-random-secret-at-least-32-characters-long
DISCORD_TOKEN=your-separate-test-bot-token
DISCORD_APPLICATION_ID=your-test-application-id
DISCORD_GUILD_ID=your-test-server-id
DISCORD_GUILD_IDS=your-test-server-id
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
AI_TOKEN_LIMIT_PARAM=max_completion_tokens
AI_MAX_OUTPUT_TOKENS=2048
AI_REASONING_EFFORT=
AI_SYSTEM_PROMPT=
WEB_API_KEY=
WEB_BASE_URL=https://api.deepseek.com/v1/tools
